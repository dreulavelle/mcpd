# Copy to .env. Nothing here is required -- these are the defaults.
#
# The rest is generated into ./data on first start: config.yaml, a bearer
# token, and the key that encrypts stored credentials. Plugin credentials are
# typed into the dashboard, not written here.

# MCP endpoint, published on loopback.
MCPD_PORT=8080
MCPD_BIND=127.0.0.1

# Admin dashboard, published on loopback.
MCPD_FRONTEND_PORT=80
MCPD_FRONTEND_BIND=127.0.0.1

# Only if your account is not uid 1000. It decides who owns ./data, and the
# shell does not export these, so compose cannot work them out:
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#UID=1000
#GID=1000
