# Copy to .env and fill in. Never commit .env.
#
# mcpd reads this file itself at startup, so anything here is available to
# `env:` references in config.yaml. Real environment variables always take
# precedence, so an orchestrator injecting a rotated secret is never
# overridden by a stale value here.

# --- required ---------------------------------------------------------------

# Bearer token for machine callers. People sign in to the dashboard with an
# email and password instead, and the tunnel authenticates itself.
# Generate one with:  openssl rand -base64 32
MCPD_TOKEN_LOCAL=

# --- ports ------------------------------------------------------------------


# MCP endpoint. Loopback by default; set MCPD_BIND to a LAN address to reach
# it directly during development.
MCPD_PORT=8080
MCPD_BIND=127.0.0.1

# Admin dashboard. The bind address defaults to loopback; set it to a LAN
# address to reach the dashboard from another machine.
MCPD_FRONTEND_PORT=80
MCPD_FRONTEND_BIND=127.0.0.1

# --- OpenAI Secure MCP Tunnel ----------------------------------------------

# The tunnel runs inside mcpd; turn it on under `tunnel:` in config.yaml and
# put the tunnel id there. Only the key belongs here.
#
# It must be a *runtime* API key from
# platform.openai.com -> Settings -> Organization -> API keys, whose principal
# has Tunnels Read + Use. An admin key is only for creating and deleting
# tunnels and will not work for the connection.
OPENAI_TUNNEL_API_KEY=

# --- plugin credentials -----------------------------------------------------
#
# Not kept here. A plugin declares the settings it needs, and they are edited
# on the Plugins page where they are validated and stored encrypted.
#
# A config file can still supply a starting value for a host nobody has opened
# yet, as a reference rather than a value: settings.<field>_ref: env:NAME.
