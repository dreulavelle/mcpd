# Copy to .env and fill in. Never commit .env.
#
# mcpd reads this file itself at startup, so anything here is available to
# `env:` references in config.yaml. Real environment variables always take
# precedence, so an orchestrator injecting a rotated secret is never
# overridden by a stale value here.

# --- required ---------------------------------------------------------------

# Bearer token for the dashboard, for machine callers, and for the tunnel.
# Generate one with:  openssl rand -base64 32
MCPD_TOKEN_LOCAL=

# --- ports ------------------------------------------------------------------

MCPD_VERSION=dev

# MCP endpoint, published on loopback only.
MCPD_PORT=8080

# Admin dashboard. The bind address defaults to loopback; set it to a LAN
# address to reach the dashboard from another machine.
MCPD_FRONTEND_PORT=80
MCPD_FRONTEND_BIND=127.0.0.1

# --- OpenAI Secure MCP Tunnel (the `tunnel` profile) ------------------------

# From platform.openai.com/settings/organization/tunnels
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=

# Which plugin endpoint this tunnel exposes. One tunnel maps to one MCP server
# URL, so run one tunnel per plugin you want a connector for.
MCPD_TUNNEL_PLUGIN=echo

# --- plugin credentials -----------------------------------------------------

MCPD_CNMAESTRO_CLIENT_ID=
MCPD_CNMAESTRO_CLIENT_SECRET=

# Administrator created on first start under auth.mode: oauth.
MCPD_BOOTSTRAP_PASSWORD=
