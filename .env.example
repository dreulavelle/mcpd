# Copy to .env. Nothing here is required — these are the defaults.
# Everything else is generated into ./data on first start.

# MCP endpoint.
MCPD_PORT=8080

# Admin dashboard.
MCPD_FRONTEND_PORT=80

# Pin a release when using docker-compose.prod.yml.
#MCPD_VERSION=latest

# Only if your account is not uid 1000:
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#UID=1000
#GID=1000
