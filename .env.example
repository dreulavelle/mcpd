# Copy to .env and fill in. Never commit .env.

# Version tag applied to the built image.
MCPD_VERSION=dev

# Host port mcpd is published on, bound to loopback.
MCPD_PORT=8080

# Bearer token for the ChatGPT connector.
# Generate one with:  openssl rand -base64 32
MCPD_TOKEN_CHATGPT=

# cnMaestro OAuth client credentials, once that plugin is enabled.
MCPD_CNMAESTRO_CLIENT_ID=
MCPD_CNMAESTRO_CLIENT_SECRET=

# Cloudflare Tunnel token, for the `tunnel` profile.
CLOUDFLARE_TUNNEL_TOKEN=
