# Copy to .env and fill in. Never commit .env.

# Version tag applied to the built image.
MCPD_VERSION=dev

# Host port the MCP endpoint is published on, bound to loopback.
MCPD_PORT=8080

# Host port the admin dashboard is published on.
MCPD_FRONTEND_PORT=80

# Bearer token for machine callers that cannot complete a browser OAuth flow.
# Generate one with:  openssl rand -base64 32
MCPD_TOKEN_CHATGPT=

# Password for the administrator created on first start, used to sign in at the
# OAuth consent screen when connecting ChatGPT. At least 12 characters.
MCPD_BOOTSTRAP_PASSWORD=

# cnMaestro OAuth client credentials, once that plugin is enabled.
MCPD_CNMAESTRO_CLIENT_ID=
MCPD_CNMAESTRO_CLIENT_SECRET=

# Cloudflare Tunnel token, for the `tunnel` profile.
CLOUDFLARE_TUNNEL_TOKEN=
