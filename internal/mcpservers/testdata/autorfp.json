{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "description": "Search AutoRFP.ai projects, requirements, content library, and tags for Q&A and analytics.",
  "name": "ai.autorfp/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{api_host}/mcp",
      "variables": {
        "api_host": {
          "choices": [
            "api.autorfp.ai",
            "api.eu.autorfp.ai",
            "api.us.autorfp.ai"
          ],
          "description": "AutoRFP.ai API host for your data-residency region.",
          "isRequired": true
        }
      }
    }
  ],
  "repository": {
    "source": "github",
    "url": "https://github.com/AutoRFP/mcp"
  },
  "title": "AutoRFP.ai",
  "version": "1.0.0",
  "websiteUrl": "https://autorfp.ai"
}